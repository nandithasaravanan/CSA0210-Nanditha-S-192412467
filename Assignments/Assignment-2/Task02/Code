
#include <stdio.h>

int calls = 0;

// Simulates slow server verification
int verify_card(int id)
{
    calls++;

    // Some passengers have valid disability cards
    return (id % 10 == 0);
}

// Function to demonstrate short-circuit evaluation
int check()
{
    calls++;
    return 1;
}

int main()
{
    int i, senior, eligible;
    int result;
    int first_order, second_order;
    int audit_calls;

    // Experiment 1: Logical AND
    calls = 0;
    result = 0 && check();
    printf("AND calls = %d\n", calls);

    // Experiment 2: Logical OR
    calls = 0;
    result = 1 || check();
    printf("OR calls = %d\n", calls);

    // Experiment 3: Bitwise AND
    calls = 0;
    result = 0 & check();
    printf("Bitwise AND calls = %d\n", calls);

    // Experiment 4: Logical AND
    calls = 0;
    result = 0 && check();
    printf("Logical AND calls = %d\n", calls);

    // Order 1: Senior condition first
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i < 200);
        eligible = 1;

        if ((senior && eligible) || verify_card(i))
        {
            // Concession granted
        }
    }

    first_order = calls;

    // Order 2: Server verification first
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i < 200);
        eligible = 1;

        if (verify_card(i) || (senior && eligible))
        {
            // Concession granted
        }
    }

    second_order = calls;

    // Mandatory audit logging
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i < 200);
        eligible = 1;

        int card = verify_card(i);

        if ((senior && eligible) || card)
        {
            // Concession granted
        }
    }

    audit_calls = calls;

    printf("\n--- SERVER CALL COUNT ---\n");
    printf("Senior condition first = %d\n", first_order);
    printf("Verification first = %d\n", second_order);
    printf("Mandatory audit calls = %d\n", audit_calls);

    return 0;
}
