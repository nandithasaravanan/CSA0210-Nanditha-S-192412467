
#include <stdio.h>

// Method 1: Else-if ladder
char grade_if(int marks)
{
    if (marks < 0 || marks > 100)
        return '?';

    if (marks >= 90)
        return 'S';
    else if (marks >= 80)
        return 'A';
    else if (marks >= 70)
        return 'B';
    else if (marks >= 60)
        return 'C';
    else if (marks >= 50)
        return 'D';
    else
        return 'F';
}

// Method 2: Switch statement
char grade_switch(int marks)
{
    if (marks < 0 || marks > 100)
        return '?';

    switch (marks / 10)
    {
        case 10:
        case 9:
            return 'S';

        case 8:
            return 'A';

        case 7:
            return 'B';

        case 6:
            return 'C';

        case 5:
            return 'D';

        case 4:
        case 3:
        case 2:
        case 1:
        case 0:
            return 'F';

        default:
            return '?';
    }
}

// Demonstration of missing break
char grade_missing_break(int marks)
{
    char grade = '?';

    switch (marks / 10)
    {
        case 9:
            grade = 'S';
            /* fall through intentionally */

        case 8:
            grade = 'A';
            break;

        default:
            break;
    }

    return grade;
}

int main(void)
{
    int marks[] = {
        -1, 0, 49, 50, 59, 60, 69,
        70, 79, 80, 89, 90, 99, 100, 101
    };

    int i;
    int n = sizeof(marks) / sizeof(marks[0]);

    printf("MARKS  ELSE-IF  SWITCH\n");
    printf("----------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("%5d     %c        %c\n",
               marks[i],
               grade_if(marks[i]),
               grade_switch(marks[i]));
    }

    // Demonstrate missing break
    printf("\n--- MISSING BREAK DEMONSTRATION ---\n");
    printf("Marks = 95\n");
    printf("Correct Grade = %c\n", grade_switch(95));
    printf("Without break = %c\n",
           grade_missing_break(95));

    return 0;
}
